-- Rivals Void Knife (Matcha)
-- F5: park yourself off to one side (up / down / left / right) of where you stand,
--     jittering to random spots inside a square so you're hard to hit.
-- F6: press once -> snap behind the nearest enemy, knife them, snap back out.
-- Height / depth limits keep you from going past the map's kill height.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LP = Players.LocalPlayer

local VOID_KEY = 0x74 -- F5 (change to any Windows VK code)
local STAB_KEY = 0x75 -- F6

-- Players that are never targeted (lowercase names)
local WHITELIST = {
    ["banned_my1account"] = true,
}

local voidActive = false
local wasVoidDown = false
local wasStabDown = false
local lastCycle = 0
local lastJitter = 0
local anchor, anchorCF, anchorRight, anchorFwd
local viewPos      -- where the camera is pinned in attacker mode
local inStab = false

-- Defaults, also used before the menu has rendered for the first time
local DEFAULTS = {
    vd_enabled = false,
    vd_dir = 3,          -- 0 Up, 1 Left, 2 Right, 3 All (random); never goes down
    vd_dist = 25,        -- studs away from where you started
    vd_range = 8,        -- half-size of the random square (studs)
    vd_interval = 0,     -- ms between random position changes (0 = every frame)
    vd_maxheight = 40,   -- never go higher than this above the anchor
    vd_maxrange = 200,   -- how far from the anchor a target can be
    vd_attack = 0,       -- 0 = M2 (backstab), 1 = M1 (slash)
    vd_behind = 2.0,
    vd_settle = 60,
    vd_attempts = 2,
    vd_retry = 150,
    vd_hold = 250,
    vd_cooldown = 700,
    vd_stayview = true,  -- attacker mode: camera stays put while the body moves
    vd_aim = true,
    vd_yawonly = true,   -- camera lock-on turns left/right only, never up/down
    vd_holdstab = true,  -- holding F6 repeats the stab instead of one stab per press
    vd_pressms = 60,     -- how long each M2 press is held down
    vd_restoreview = true,
    vd_team = true,
    vd_walls = true,     -- wall protection (don't pick spots behind / inside walls)
    vd_edge = true,      -- map-edge protection (don't pick spots with no floor below)
    vd_auto = false,     -- stab automatically instead of waiting for F6
}

local function get(id)
    local ok, v = pcall(UI.GetValue, id)
    if ok and v ~= nil then return v end
    return DEFAULTS[id]
end

-- ===== Config save / load =====
local CONFIG_FILE = "rivals_voidknife.json"
local lastSaved = ""
local lastSaveCheck = 0

local function loadConfig()
    local ok, data = pcall(function()
        if isfile(CONFIG_FILE) then
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
    end)
    if ok and type(data) == "table" then
        for id, v in pairs(data) do
            if DEFAULTS[id] ~= nil and type(v) == type(DEFAULTS[id]) then
                DEFAULTS[id] = v
            end
        end
        print("VoidKnife: config loaded")
    end
end

local function saveConfig()
    local data = {}
    for id in pairs(DEFAULTS) do
        data[id] = get(id)
    end
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and enc ~= lastSaved then
        if pcall(writefile, CONFIG_FILE, enc) then
            lastSaved = enc
        end
    end
end

loadConfig()

